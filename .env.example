# Application
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
APP_DOMAIN=studio.example.edu.vn
CADDY_EMAIL=admin@example.edu.vn

# PostgreSQL
DATABASE_URL=postgresql+psycopg://scorm:change_me@postgres:5432/scorm_studio
POSTGRES_DB=scorm_studio
POSTGRES_USER=scorm
POSTGRES_PASSWORD=change_me
# Use a long random value in production. Never expose PostgreSQL on the host network.

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=change_me

# Auth
JWT_SECRET=replace_with_long_random_value
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# Encryption master key for teacher AI credentials
# Generate outside source control with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Never reuse JWT_SECRET. Required when APP_ENV=production.
CREDENTIAL_ENCRYPTION_KEY=replace_with_fernet_key_or_kms_managed_secret

# HMAC key used only to turn K12Online learner identifiers into irreversible analytics tokens.
# Generate a different random value for every production environment; never rotate it without a migration plan.
ANALYTICS_PSEUDONYM_KEY=replace_with_long_random_value

# S3-compatible storage / Cloudflare R2
S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=scorm-studio
S3_ACCESS_KEY_ID=replace_me
S3_SECRET_ACCESS_KEY=replace_me
S3_PUBLIC_BASE_URL=

# Encrypted PostgreSQL backups uploaded to a separate R2 bucket.
BACKUP_S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=scorm-studio-backups
BACKUP_S3_ACCESS_KEY_ID=replace_me
BACKUP_S3_SECRET_ACCESS_KEY=replace_me
# Generate a unique long random passphrase; keep it in the VPS secret store only.
BACKUP_ENCRYPTION_PASSPHRASE=replace_with_long_random_passphrase
BACKUP_RETENTION_DAYS=35
BACKUP_INTERVAL_SECONDS=86400

# AI defaults — provider keys are normally per-user encrypted credentials,
# not shared server keys. These optional values are for development only.
AI_DEFAULT_PROVIDER=mock
AI_DEFAULT_MODEL=mock

# Observability
LOG_LEVEL=INFO
SENTRY_DSN=
