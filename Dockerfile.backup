FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client gnupg \
    && rm -rf /var/lib/apt/lists/* \
    && addgroup --system backup && adduser --system --ingroup backup backup
RUN pip install --no-cache-dir "boto3>=1.35,<2.0"
COPY ops ./ops
RUN chmod 0555 /app/ops/*.sh && chown -R backup:backup /app
USER backup
CMD ["/app/ops/backup-loop.sh"]
